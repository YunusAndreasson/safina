# Build output
/bin/
/.build/

# Bench harness outputs (timestamped CSV + Markdown reports). bench/baseline.json
# is the only checked-in artifact — the regression-gate contract.
/bench/out/results-*.csv
/bench/out/report-*.md
/bench/fixtures/manifests.yaml

# Stray binary from `go build` without -o
/safina

# Local debug logs from SAFINA_DEBUG=1 (don't commit user activity)
*.log
debug.log

# Editor
.idea/
.vscode/
*.swp
*.swo

# Claude Code local state (personal settings + transient run locks)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS
.DS_Store

# Website (site/)
/site/node_modules/
/site/dist/
/site/.astro/
/site/.demo/
/site/.frames/
/site/.wrangler/
