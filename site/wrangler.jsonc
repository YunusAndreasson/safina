{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The one Worker this site ships to. scripts/ship.mjs refuses any other
  // name, so a copied config can't overwrite another Worker on the account
  // (openarabic.io's live Worker shares it).
  "name": "safina-site",

  // No newer than the workerd that wrangler installs, or `wrangler dev` won't start.
  "compatibility_date": "2026-10-23",

  // Static files only: no `main`, so no Worker code runs and every request is
  // the asset server's. public/_headers sets caching and content types.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // astro.config.mjs `trailingSlash: "never"`.
    "html_handling": "drop-trailing-slash"
  },

  // safina.run, bought through Cloudflare Registrar on 2026-11-08, is the
  // site's one address. Keep this route: a deploy without it could detach
  // the domain. Add no other route or domain; ship.mjs refuses both.
  "routes": [{ "pattern": "safina.run", "custom_domain": true }],
  // No second copy on workers.dev or preview URLs: every deploy is checked
  // on the live domain.
  "workers_dev": false,
  "preview_urls": false
}
