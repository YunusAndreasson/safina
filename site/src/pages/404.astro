---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Safina" description="There is no page at this address.">
  <div class="lost wrap">
    <a class="wordmark" href="/" aria-label="Safina, home">safina</a>
    <main id="main" class="lost__body">
      <pre class="lost__art" aria-hidden="true">                                      .
                                      |
         ___ ___ ___ ___ ___ ___     _|_
        |___|___|___|___|___|___|   |o o|
        |___|___|___|___|___|___|___|o o|__
  ______|___________________________|_____|
  \    s a f i n a                        /
   \_____________________________________/
 ~~~~ ~~~~~~~~ ~~~~~ ~~~~~~~~~~ ~~~~~~ ~~~~~~    \o/  ~~</pre>
      <h1>Overboard.</h1>
      <p>Nothing lives at this address. Others have come back from the belly of a whale, and your way back is shorter.</p>
      <a class="btn btn--beacon" href="/">Back aboard</a>
    </main>
  </div>
</Base>

<style>
  /* The nav's band on top, then the message on the title line, with the
     space left over split 1 : φ above and below it, so it rests just over
     the middle, where the eye expects the centre. */
  .lost {
    display: grid;
    grid-template-rows: 68px 1fr auto 1.618fr;
    min-height: 100svh;
  }
  .lost > .wordmark {
    align-self: center;
    justify-self: start;
  }
  .lost__body {
    grid-row: 3;
    max-width: var(--measure);
  }
  /* The ship from the page source sails on, and you wave from its wake:
     plain ASCII in the terminal's face, quiet ink, as old 404s were drawn.
     Sized so its 54 columns fit a phone. */
  .lost__art {
    margin: 0 0 var(--s3);
    font-family: var(--mono);
    font-size: min(0.8125rem, 2.6vw);
    line-height: 1.25;
    color: var(--fog);
    white-space: pre;
  }
  p {
    margin-top: var(--s2);
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--spray);
  }
  .btn {
    margin-top: var(--s3);
  }
</style>
