---
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Opening from "../components/Opening.astro";
import Tour from "../components/Tour.astro";
import Feature from "../components/Feature.astro";
import Frame from "../components/Frame.astro";
import KeyList from "../components/KeyList.astro";
import Interlude from "../components/Interlude.astro";
import Aboard from "../components/Aboard.astro";
import Compare from "../components/Compare.astro";
import Questions from "../components/Questions.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";
import chatCast from "../assets/casts/chat.cast?url";
import fixCast from "../assets/casts/fix.cast?url";
import historyCast from "../assets/casts/history.cast?url";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const shot = (name: string) => {
  const img = files[`../assets/shots/${name}.png`]?.default;
  if (!img) throw new Error(`missing screenshot: ${name}.png`);
  return img;
};
---

<Base
  title="Safina: the Kubernetes TUI for teams that ship fast"
  description="A terminal UI for Kubernetes, for teams that ship fast. It answers a keypress in about 20 ms, jumps to what’s broken and shows you why, and asks before every write."
>
  <Nav />
  <main id="main">
    <Opening />
    <Tour />

    {/* Features, as the nav names it: the named features, Chat to the interlude, and Also on board after Speed (data-nav in Aboard.astro). */}
    <div id="features">
      <Feature id="chat" name="Chat" heading="It already knows what you’re looking at.">
        <p>
          Press <kbd class="cap">i</kbd> and ask what’s wrong. The model gets the cluster, namespace and resource you’re
          on and, from the Logbook, what you’ve already tried there, so you don’t paste stack traces into a
          browser tab. Open a logs entry in the Logbook and <kbd class="cap">c</kbd> hands it the lines
          you&nbsp;read.
        </p>
        <p>
          It answers with keys to press, like <kbd class="cap">e</kbd> for events or <kbd class="cap">U</kbd> to roll
          back, and it can’t press them itself. The cluster stays your <i>amanah</i>, your trust and
          your&nbsp;call.
        </p>
        <Frame
          slot="figure"
          src={shot("chat")}
          crop={shot("chat-m")}
          cast={{ src: chatCast, still: "chat", key: "c", label: "attach to chat", end: "still" }}
          panCols={99}
          alt="The chat panel beside the workloads list, answering from the crash logs attached from the Logbook: ledger-api starts v2.14.0 at 11:15:50, can’t reach the database on three retries, fails the lookup of ledger-db-primary with no such host, and panics. The cause: the cluster’s DNS has no record for ledger-db-primary, so no Service has that name or the config names the wrong one, and pressing R won’t help. Next: press d to find where the host is set, filter the Services for ledger-db to find the real name, and press E to change it."
        />
      </Feature>

      <Feature id="safety" name="Barbarossa mode" heading="Lowercase reads. Uppercase writes.">
        <p>
          A slipped finger can only ever read. The keys that write are <b>Barbarossa&nbsp;mode</b>, named for the
          red-&#8288;bearded Ottoman admiral. They all need Shift, and they’re red, like every confirmation. Scaling
          asks how many, an edit shows you the diff before it’s applied, and everything else asks for a&nbsp;yes.
        </p>
        <p>
          Then <b>Rollout watch</b> takes over. A scale, restart or edit isn’t done just because the API accepted it, so
          safina follows it until the pods are ready. If they still aren’t after five minutes, it&nbsp;tells&nbsp;you.
        </p>
        <p class="quiet">
          <b>No autopilot</b> means safina never picks a cluster for you, not even&nbsp;yesterday’s.
        </p>
        <Frame
          slot="figure"
          src={shot("diff-f")}
          crop={shot("diff-m")}
          cast={{ src: fixCast, still: "diff", strip: true, key: "y", label: "apply", end: "hold" }}
          panCols={80}
          panStart={15}
          alt="An edit to the ledger-api Deployment waiting for confirmation in a red frame: a one-line diff changes DATABASE_URL from ledger-db-primary to ledger-db, with a red y to apply and n to cancel."
        />
        <div slot="after" class="keys">
          <KeyList />
        </div>
      </Feature>

      <Feature id="logbook" name="Logbook" heading="Still there in the morning.">
        <p>
          Kubernetes keeps events for an hour by default, and a replaced pod takes its logs with it. The <b>Logbook</b> keeps
          what you saw: the logs and events you read, and every write with the state before and
          after&nbsp;it.
        </p>
        <p>
          Afterwards, export the night, from the <i>bismillah</i> before your first look
          to the <i>alhamdulillah</i> when the pods are ready, as a timeline with a postmortem template. That works without cluster access, which helps when the cluster was the problem. Every
          entry keeps its <i>isnad</i>, the
          chain it came through: which cluster, which session, when it happened and when you&nbsp;saw&nbsp;it.
        </p>
        <p class="quiet">
          It lives on your machine, readable only by you, with secrets redacted. It records what you did and saw in
          safina, so it isn’t an audit log of the&nbsp;cluster.
        </p>
        <Frame
          slot="figure"
          src={shot("history")}
          crop={shot("history-m")}
          cast={{ src: historyCast, still: "history", key: ":", label: "logbook", end: "still" }}
          panCols={80}
          panStart={26}
          alt="The Logbook for ledger-api, newest first: the DATABASE_URL edit, timestamped from requested, through the before snapshot, the changed fields, the API accepting it and the after snapshot, to progress at 0 and then 1 of 2 ready, and completed at 2 of 2 ready eight seconds after it was requested."
        />
      </Feature>

      <Interlude />
    </div>
    <Compare />
    <Aboard />
    <Questions />
    <Install />
  </main>
  <Footer />
</Base>

<style>
  .keys {
    margin-top: var(--s4);
  }
</style>
