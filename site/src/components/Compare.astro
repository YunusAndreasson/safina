---
// Safina next to k9s: a check or a dash, nothing to read. Every k9s mark is
// checked against the k9s README, k9scli.io and its latest release (v0.51.0,
// June 2026); every safina mark against this repo. Recheck both when either
// changes, and keep k9s's wins in: the dashes on safina's side are what make
// its checks believable.
//   Confirmation on every write: k9s's Ctrl-K kill has no confirmation dialog.
//   All resource types by default: safina shows six groups; others
//   are added. Labels stay short and precise, two to five words. Each row
//   uses the field's own terms (kubectl's "rollout status" and "resource types"; "AI assistant" as Headlamp and Lens tables say;
//   k9s's "read-only mode", "plugins", "skins"), never a safina feature name.
// "some" is a half answer: k9s asks before a delete but not a kill; safina
// shows six resource groups and you add the rest.
type Mark = boolean | "some";

// Measured: medians from cmd/safina-versus (`make versus`, method in
// docs/development.md), both tools in one 200×50 pseudo-terminal against the
// same cluster through one recording API proxy. Latency is keystroke to the
// first correct frame. `ahead` names the side whose whole 95% interval beats
// the other by 5% and 1 ms; null is a tie. Keep k9s's wins and the ties in,
// for the same reason as the dashes below. Re-run on a release and update
// every row and the note together; never round a tie into a win.
// Report: safina v0.3.0 vs k9s v0.51.0, 10 rounds, seed 42, 10 Nov 2026
// (versus-20261110-131310).
type Side = "safina" | "k9s" | null;
const measured: { label: string; safina: string; k9s: string; ahead: Side }[] = [
  { label: "Launch to the pod list, all namespaces", safina: "0.7 s", k9s: "2.9 s", ahead: "safina" },
  { label: "Move the cursor one row", safina: "20 ms", k9s: "28 ms", ahead: "safina" },
  { label: "Filter 500 pods by name", safina: "139 ms", k9s: "343 ms", ahead: "safina" },
  { label: "Switch from pods to deployments", safina: "33 ms", k9s: "112 ms", ahead: "safina" },
  { label: "Open a pod’s YAML", safina: "64 ms", k9s: "68 ms", ahead: null },
  { label: "Back out of the YAML", safina: "27 ms", k9s: "145 ms", ahead: "safina" },
  { label: "Open logs to the first line", safina: "80 ms", k9s: "115 ms", ahead: "safina" },
  { label: "CPU while idle, of one core", safina: "7%", k9s: "15%", ahead: "safina" },
  { label: "Memory", safina: "187 MB", k9s: "179 MB", ahead: null },
  { label: "API requests while idle", safina: "18/min", k9s: "4/min", ahead: "k9s" },
];
const rows: { label: string; safina: Mark; k9s: Mark }[] = [
  { label: "Write actions need Shift", safina: true, k9s: false },
  { label: "Confirmation on every write", safina: true, k9s: "some" },
  { label: "Rollout status after scale, restart or edit", safina: true, k9s: false },
  { label: "Cluster picker at launch", safina: true, k9s: false },
  { label: "AI assistant", safina: true, k9s: false },
  { label: "Incident timeline export", safina: true, k9s: false },
  { label: "All resource types by default", safina: "some", k9s: true },
  { label: "Read-only mode", safina: false, k9s: true },
  { label: "Plugins and skins", safina: false, k9s: true },
  { label: "Windows support", safina: false, k9s: true },
  { label: "Package manager install", safina: false, k9s: true },
];
---

<section class="compare" id="compare" aria-labelledby="compare-title">
  <div class="wrap split">
    <div class="compare__head split__title">
      <hgroup>
        <p class="section-name">Compare</p>
        <h2 id="compare-title" class="h2-ref">Safina and k9s</h2>
      </hgroup>
      <p class="compare__lede">Both read the same kubeconfig, so you can run them side&nbsp;by&nbsp;side.</p>
    </div>
    <div class="compare__body">
      <table class="compare__table">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="compare__name compare__name--safina">safina</th>
            <th scope="col" class="compare__name">k9s</th>
          </tr>
        </thead>
        <tbody>
          <tr class="compare__group">
            <th scope="rowgroup">Measured</th>
            <td class="compare__mark compare__mark--safina"></td>
            <td class="compare__mark"></td>
          </tr>
          {
            measured.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {(["safina", "k9s"] as const).map((side) => (
                  <td
                    class:list={[
                      "compare__mark",
                      "compare__num",
                      { "compare__mark--safina": side === "safina", "compare__num--ahead": r.ahead === side },
                    ]}
                  >
                    {r[side]}
                    {r.ahead === side && <span class="visually-hidden"> (better)</span>}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
        <tbody>
          <tr class="compare__group">
            <th scope="rowgroup">Features</th>
            <td class="compare__mark compare__mark--safina"></td>
            <td class="compare__mark"></td>
          </tr>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {[r.safina, r.k9s].map((has, i) => (
                  <td class:list={["compare__mark", { "compare__mark--safina": i === 0 }]}>
                    {has === "some" ? (
                      <span class="some">Some</span>
                    ) : has ? (
                      <svg class="check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                        <path d="M3.2 8.6 6.5 11.8 12.8 4.6" />
                      </svg>
                    ) : (
                      <span class="dash" aria-hidden="true" />
                    )}
                    {has !== "some" && <span class="visually-hidden">{has ? "Yes" : "No"}</span>}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="compare__note">
        Measured: medians of 10 launches each, safina v0.3.0 and k9s v0.51.0 at its defaults, with 500 pods on a local
        minikube cluster and an Intel i7-7820HQ laptop. Times run from the keypress to the first correct frame. A
        brighter figure is ahead by more than the run-to-run spread, and the rest are ties. Most of safina’s idle
        requests re-read pod metrics every 5&nbsp;seconds.
        <a href="https://github.com/YunusAndreasson/safina/blob/main/docs/development.md#comparing-with-k9s">Run&nbsp;it&nbsp;yourself</a> with <code>make&nbsp;versus</code>. Features: k9s as of v0.51.0, June&nbsp;2026.
      </p>
    </div>
  </div>
</section>

<style>
  .compare {
    padding-top: var(--s5);
    background: var(--abyss);
  }
  .compare .split {
    row-gap: var(--s3);
  }
  .compare h2 {
    max-width: 17ch;
  }
  .compare__body {
    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }
  /* The title and the one sentence that frames the table, as one block on
     the title line: the table alone takes the text line, starting level
     with the title. */
  .compare__lede {
    max-width: 28ch;
    margin-top: var(--s2);
    color: var(--spray);
    text-wrap: balance;

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }

  /* Names left, two narrow columns of marks. */
  .compare__table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0;
    font-weight: inherit;
    text-align: start;
  }
  tbody th {
    padding-block: 11px;
    padding-inline-end: 16px;
    color: var(--spray);
    text-wrap: balance;
  }
  tbody tr {
    border-top: 1px solid var(--hairline);
  }
  .compare__name,
  .compare__mark {
    width: 6.5rem;
    text-align: center;
    vertical-align: middle;

    @media (width <= 640px) {
      width: 4.75rem;
    }
  }
  /* The names in the feature names' hull lettering; safina's in cyan. */
  .compare__name {
    padding-block: 12px 10px;
    font-size: var(--t-ui);
    font-weight: 400;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    color: var(--fog);
  }
  /* safina's column: one faint band of the beacon, top to bottom. */
  .compare__name--safina,
  .compare__mark--safina {
    background: rgb(from var(--beacon) r g b / 6%);
  }
  .compare__name--safina {
    border-radius: 12px 12px 0 0;
    color: var(--beacon);
  }
  tbody:last-child tr:last-child .compare__mark--safina {
    border-radius: 0 0 12px 12px;
  }

  /* Each group opens on its name in the column names' hull lettering, with
     room above it: a heading for the rows, not a row to read. The band
     runs through. */
  .compare__group {
    border-top: 0;
  }
  .compare__group th {
    padding-block: var(--s3) 10px;
    font-size: var(--t-ui);
    font-weight: 400;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    color: var(--fog);
  }
  tbody:first-child .compare__group th {
    padding-top: 8px;
  }

  /* Figures line up digit for digit; the side that's ahead takes the
     brightest ink (safina's in the beacon), the other stays quiet. */
  .compare__num {
    font-variant-numeric: tabular-nums;
    font-size: var(--t-small);
    color: var(--fog);
    white-space: nowrap;
  }
  .compare__num--ahead {
    color: var(--foam);
  }
  .compare__num--ahead.compare__mark--safina {
    color: var(--beacon);
  }

  .check {
    display: block;
    margin-inline: auto;
    fill: none;
    stroke: var(--foam);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .compare__mark--safina .check {
    stroke: var(--beacon);
  }
  .dash {
    display: block;
    width: 10px;
    height: 1.5px;
    margin-inline: auto;
    border-radius: 1px;
    background: rgb(from var(--fog) r g b / 55%);
  }

  /* A half answer, in words, quieter than a check. */
  .some {
    font-size: var(--t-micro);
    letter-spacing: 0.02em;
    color: var(--fog);
  }

  .compare__note {
    margin-top: var(--s1);
    font-size: var(--t-small);
    color: var(--fog);
  }
</style>
