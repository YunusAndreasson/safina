---
// Speed: safina timed against k9s, the payoff of the hero's "about 20 ms".
// Medians from cmd/safina-versus (`make versus`, method in
// docs/development.md), both tools in one 200×50 pseudo-terminal against the
// same cluster through one recording API proxy. Latency is keystroke to the
// first correct frame. `ahead` names the side whose whole 95% interval beats
// the other by 5% and 1 ms; null is a tie. Keep k9s's wins and the ties in:
// they're what make safina's wins believable. Re-run on a release and update
// every row and the note together; never round a tie into a win.
// Report: safina v0.3.0 vs k9s v0.51.0, 10 rounds, seed 42, 10 Nov 2026
// (versus-20261110-131310). Values are the report's medians, unrounded: the
// figures and the ratio are both derived from them, so they agree.
// Lower is better on every row. Each row's bars are scaled to its own slower
// side, so a bar compares within its row only; the figures carry the scale.
type Side = "safina" | "k9s" | null;
type Row = { label: string; safina: number; k9s: number; unit: "ms" | "%" | "MB" | "/min"; ahead: Side; less?: string };
const groups: { name: string; rows: Row[] }[] = [
  {
    name: "Keypress to the first correct frame",
    rows: [
      { label: "Launch to the pod list, all namespaces", safina: 689.9, k9s: 2944.1, unit: "ms", ahead: "safina" },
      { label: "Move the cursor one row", safina: 19.8, k9s: 28.3, unit: "ms", ahead: "safina" },
      { label: "Filter 500 pods by name", safina: 139.4, k9s: 342.5, unit: "ms", ahead: "safina" },
      { label: "Switch from pods to deployments", safina: 33.4, k9s: 112.3, unit: "ms", ahead: "safina" },
      { label: "Open a pod’s YAML", safina: 63.6, k9s: 67.9, unit: "ms", ahead: null },
      { label: "Back out of the YAML", safina: 27.2, k9s: 144.5, unit: "ms", ahead: "safina" },
      { label: "Open logs to the first line", safina: 79.8, k9s: 114.7, unit: "ms", ahead: "safina" },
    ],
  },
  {
    name: "Footprint",
    rows: [
      { label: "CPU while idle, of one core", safina: 6.6, k9s: 15.1, unit: "%", ahead: "safina", less: "less" },
      { label: "Memory", safina: 187.1, k9s: 179.3, unit: "MB", ahead: null },
      { label: "API requests while idle", safina: 18, k9s: 4, unit: "/min", ahead: "k9s", less: "fewer" },
    ],
  },
];

// Seconds once a row reaches a second, so both sides of a row share a unit.
function fmt(v: number, r: Row): string {
  if (r.unit === "ms") return Math.max(r.safina, r.k9s) >= 1000 ? `${(v / 1000).toFixed(2)} s` : `${String(Math.round(v))} ms`;
  const n = String(Math.round(v));
  if (r.unit === "MB") return `${n} MB`;
  return r.unit === "%" ? `${n}%` : `${n}/min`;
}
function diff(r: Row): string {
  if (!r.ahead) return "Tie";
  const x = (Math.max(r.safina, r.k9s) / Math.min(r.safina, r.k9s)).toFixed(1);
  const what = r.less ?? "faster";
  return r.ahead === "safina" ? `${x}× ${what}` : `k9s, ${x}× ${what}`;
}
const sides = ["safina", "k9s"] as const;
---

<section class="speed" id="compare" aria-labelledby="speed-title">
  <div class="wrap">
    <div class="speed__head split">
      <hgroup>
        <p class="section-name">Speed</p>
        <h2 id="speed-title" class="h2-ref">Timed against k9s</h2>
      </hgroup>
      <p class="speed__lede">
        Both run in one terminal against the same 500 pods. The same keys go to each, and the clock is read from
        outside&nbsp;both.
      </p>
    </div>
    <div class="speed__body">
    <table class="speed__table">
      <thead>
        <tr>
          <td></td>
          <th scope="col" class="speed__legend">
            <span class="speed__key speed__key--safina">safina</span>
            <span class="speed__key">k9s</span>
          </th>
          <th scope="col" class="speed__diff-head">Difference</th>
        </tr>
      </thead>
      {
        groups.map((g) => (
          <tbody>
            <tr class="speed__group">
              <th scope="rowgroup" colspan="3">
                {g.name}
              </th>
            </tr>
            {g.rows.map((r) => {
              const max = Math.max(r.safina, r.k9s);
              return (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td class="speed__bars">
                    {sides.map((side) => (
                      <span class:list={["speed__line", `speed__line--${side}`, { "speed__line--ahead": r.ahead === side }]}>
                        <span class="speed__bar" style={`--w: ${((r[side] / max) * 100).toFixed(1)}%`} aria-hidden="true" />
                        <span class="speed__fig">
                          <span class="visually-hidden">{side} </span>
                          {fmt(r[side], r)}
                        </span>
                      </span>
                    ))}
                  </td>
                  <td class:list={["speed__diff", { "speed__diff--safina": r.ahead === "safina", "speed__diff--k9s": r.ahead === "k9s" }]}>
                    {diff(r)}
                  </td>
                </tr>
              );
            })}
          </tbody>
        ))
      }
    </table>
    </div>
    <p class="speed__note">
      Medians of 10 launches each, safina v0.3.0 and k9s v0.51.0 at its defaults, on a local minikube cluster and an
      Intel i7-7820HQ laptop. A difference counts only when it’s larger than the run-to-run spread; the rest are ties.
      Most of safina’s idle requests re-read pod metrics every 5&nbsp;seconds. <a href="https://github.com/YunusAndreasson/safina/blob/main/docs/development.md#comparing-with-k9s">Run&nbsp;it&nbsp;yourself</a> with <code>make&nbsp;versus</code>.
    </p>
  </div>
</section>

<style>
  .speed {
    padding-top: var(--s4);
    background: var(--abyss);
  }
  .speed__head {
    row-gap: var(--s2);
  }
  .speed__lede {
    color: var(--spray);

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }

  /* The labels take the title column and the bars start on the text line,
     so the table hangs off the page's two verticals like every section. */
  .speed__body {
    container-type: inline-size;
    margin-top: var(--s3);
  }
  .speed__table {
    width: 100%;
    border-collapse: collapse;

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }
  th,
  td {
    padding: 0;
    font-weight: inherit;
    text-align: start;
    vertical-align: middle;
  }
  tbody th[scope="row"] {
    width: calc((100cqw - var(--col-gap)) * 5 / 11 + var(--col-gap));
    padding-block: 12px;
    padding-inline-end: 16px;
    color: var(--spray);
    text-wrap: balance;

    @media (width <= 1100px) {
      width: auto;
    }
  }
  tbody tr {
    border-top: 1px solid var(--hairline);
  }

  /* The names in hull lettering, safina's in the beacon like its bars. */
  .speed__legend,
  .speed__diff-head,
  .speed__group th {
    font-size: var(--t-ui);
    font-weight: 400;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    color: var(--fog);
  }
  .speed__legend {
    display: flex;
    gap: var(--s2);
    padding-bottom: 10px;
  }
  .speed__key--safina {
    color: var(--beacon);
  }
  .speed__diff-head {
    padding-bottom: 10px;
    text-align: end;
  }
  .speed__group {
    border-top: 0;
  }
  .speed__group th {
    padding-block: var(--s3) 10px;
  }
  tbody:first-of-type .speed__group th {
    padding-top: 8px;
  }

  /* Two bars a row, each with its figure at its end. The side that's ahead
     takes the brightest ink, safina's in the beacon; the other stays quiet. */
  .speed__bars {
    padding-block: 10px;
  }
  .speed__line {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 20px;
  }
  .speed__bar {
    width: calc(var(--w) * 0.78);
    min-width: 3px;
    height: 6px;
    border-radius: 3px;
    background: rgb(from var(--fog) r g b / 45%);
  }
  .speed__line--safina .speed__bar {
    background: rgb(from var(--beacon) r g b / 55%);
  }
  .speed__line--ahead.speed__line--safina .speed__bar {
    background: var(--beacon);
  }
  .speed__line--ahead.speed__line--k9s .speed__bar {
    background: var(--foam);
  }
  .speed__fig {
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
    color: var(--fog);
    white-space: nowrap;
  }
  .speed__line--ahead .speed__fig {
    color: var(--foam);
  }
  .speed__line--ahead.speed__line--safina .speed__fig {
    color: var(--beacon);
  }

  .speed__diff {
    width: 9.5rem;
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
    text-align: end;
    color: var(--fog);
    white-space: nowrap;
  }
  .speed__diff--safina {
    color: var(--beacon);
  }
  .speed__diff--k9s {
    color: var(--foam);
  }

  /* On a phone each row stacks: the label and its difference on one line,
     the bars under them at the full width. */
  @media (width <= 640px) {
    tbody tr:not(.speed__group) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 12px;
      padding-block: 12px;
    }
    tbody th[scope="row"] {
      padding: 0;
    }
    .speed__bars {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-block: 6px 0;
    }
    .speed__diff {
      width: auto;
    }
    thead td,
    .speed__diff-head {
      display: none;
    }
  }

  .speed__note {
    margin-top: var(--s2);
    max-width: var(--measure);
    font-size: var(--t-small);
    color: var(--fog);
  }
</style>
