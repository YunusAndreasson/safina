---
// The smaller features, each a name and the one line that sells it. The
// title above, then the list across the page grid two a row: the left item
// on the title line, the right on the text line, so no column stands empty.
const items: { name: string; keys: string[]; text: string }[] = [
  {
    name: "Shell anywhere",
    keys: ["s"],
    text: "A shell in any container. If the image doesn’t have one, safina asks before adding a debug container that does.",
  },
  {
    name: "Forward list",
    keys: ["Ctrl", "F"],
    text: "All your port-forwards in one list, so none of them keeps running in a terminal tab you forgot about.",
  },
  {
    name: "Quick switch",
    keys: ["Ctrl", "K"],
    text: "Switch clusters without quitting safina. It leaves kubectl’s current context alone, so your other terminals stay where you left them.",
  },
  {
    name: "Jump search",
    keys: [":"],
    text: "Type part of a name to jump to anything safina has loaded, or to a view like the Logbook.",
  },
  {
    name: "Copy over SSH",
    keys: ["y"],
    text: "The selection, the YAML or the logs go to your own clipboard, even when safina runs on a box you SSHed into.",
  },
  {
    name: "Beacon",
    keys: [],
    text: "If your terminal shows tab status, safina’s tab tells you when the model is answering or a write is waiting for your yes, so you can work in another tab.",
  },
];
---

<section class="aboard" id="aboard" data-nav="#features" aria-labelledby="aboard-title">
  <div class="wrap">
    <h2 id="aboard-title" class="h2-ref">Also on board</h2>
    <dl class="aboard__list split">
      {
        items.map((it) => (
          <div class="aboard__item">
            <dt>
              <span class="aboard__name">{it.name}</span>
              {it.keys.length > 0 && (
                <span class="aboard__keys">
                  {it.keys.map((k) => (
                    <kbd class="cap">{k}</kbd>
                  ))}
                </span>
              )}
            </dt>
            <dd>{it.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .aboard {
    padding-top: var(--s5);
    background: var(--abyss);
  }
  .aboard h2 {
    max-width: 17ch;
  }
  /* Two a row on the page's two lines, ruled like the key list's groups.
     Stacked, two a row inside the measure; one a row on a phone. */
  .aboard__list {
    margin-top: var(--s3);
    row-gap: var(--s3);

    @media (width <= 1100px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s3);
      max-width: var(--measure);
    }
    @media (width <= 640px) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s2);
    }
  }
  .aboard__item {
    padding-top: var(--s1);
    border-top: 1px solid var(--hairline);
  }
  dt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 2em;
  }
  /* The feature names' hull lettering (Feature.astro), at the size of a
     label. */
  .aboard__name {
    font-size: var(--t-ui);
    font-weight: 400;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    color: var(--foam);
  }
  .aboard__keys {
    display: inline-flex;
    gap: 4px;
  }
  .aboard__keys .cap {
    font-size: var(--t-micro);
    height: 1.9em;
  }
  dd {
    max-width: 52ch;
    margin: var(--s1) 0 0;
    color: var(--spray);
    font-size: var(--t-small);
    line-height: 1.55;
    text-wrap: pretty;
  }
</style>
