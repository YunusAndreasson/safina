---
// The page's parts in the words every product site uses (Jakob's law), in
// page order, each lit while you're in it (src/scripts/nav.ts). The page
// shows the same word for each: the hero's "Deep dive" button, Features
// for the named features from Chat to Also on board, and the eyebrows over
// Compare's and FAQ's titles. The button lights up at Get safina.
const links = [
  { href: "#tour", label: "Deep dive" },
  { href: "#features", label: "Features" },
  { href: "#compare", label: "Compare" },
  { href: "#questions", label: "FAQ" },
];
---

<header class="nav">
  <nav class="nav__inner wrap" aria-label="Primary" data-spy>
    <a class="wordmark" href="#top" aria-label="Safina, back to top">safina</a>
    <ul class="nav__links" role="list">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a class="btn btn--beacon nav__cta" href="#install">Get safina</a>
  </nav>
</header>

<script src="../scripts/nav.ts"></script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    height: var(--nav-h);
  }
  .nav__links {
    display: flex;
    gap: clamp(14px, 2.4vw, 32px);
    padding: 0;
    list-style: none;
    font-size: var(--t-ui);
  }
  /* The links wear the section names' hull lettering (.section-name), the
     same as the wordmark beside them, in the quiet ink. Pointed at, they
     brighten; the part you're in takes the names' cyan, the colour that
     marks where you are. */
  .nav__links a {
    color: var(--spray);
    font-weight: 400;
    font-stretch: 125%;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding-block: 12px;
    transition: color 200ms var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--foam);
  }
  .nav__links a[aria-current] {
    color: var(--beacon);
  }
  /* The button stays put from the first frame, as the primary action in the
     best product bars does: the hero repeats it a size larger, which ranks
     them without moving either. At Get safina the button is where you are:
     it holds its lit, hovered state. */
  .nav__cta[aria-current] {
    --lift: 0.035;
    box-shadow:
      0 1px 0 0 rgb(from var(--foam) r g b / 70%) inset,
      0 -1px 0 0 rgb(from var(--beacon-ink) r g b / 18%) inset,
      0 10px 28px -14px rgb(from var(--beacon) r g b / 70%);
  }
  .nav__cta {
    min-height: 40px;
    margin-left: auto;
    padding-inline: 1.1em;
    font-size: var(--t-ui);
  }

  /* On the page grid: the name on the title line, the links on the text
     line, the button on the column's end. The nav is the first place the
     eye meets the verticals every section below hangs from. */
  @media (width > 1100px) {
    .nav__inner {
      display: grid;
      grid-template-columns: var(--split);
      column-gap: var(--col-gap);
    }
    .nav__inner > .wordmark {
      grid-area: 1 / 1;
      justify-self: start;
    }
    /* The text line is narrowest just past 1100px: the names close up
       there, so the last one stays well clear of the button. */
    .nav__links {
      grid-area: 1 / 2;
      justify-self: start;
      gap: clamp(18px, 4vw - 26px, 32px);
    }
    .nav__cta {
      grid-area: 1 / 2;
      justify-self: end;
      margin-left: 0;
    }
  }

  @media (width <= 720px) {
    .nav__links {
      display: none;
    }
  }

  /* Transparent over the photo, solid once the page moves on. */
  @supports (animation-timeline: scroll()) {
    .nav {
      animation: nav-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 50svh 90svh;
    }
  }
  @keyframes nav-solid {
    to {
      background: rgb(from var(--abyss) r g b / 72%);
      border-bottom-color: var(--hairline);
      backdrop-filter: blur(14px) saturate(1.2);
    }
  }
</style>
