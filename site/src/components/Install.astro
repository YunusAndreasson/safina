---
import { getImage } from "astro:assets";
import firstLight from "../assets/img/first-light.jpg";
import { release, downloadUrl } from "../data/release";

const widths = [960, 1280, 1672];
// Shown one command per line; copied as the single line it is. A line too
// long for its column may break in one place only, between a URL's host and
// its path, so `owner/repo` never splits and no word is left alone.
const steps = release.fromSource.split(" && ").map((line) => {
  const m = /^(.*?:\/\/[^/]+\/)(.+)$/.exec(line);
  return m ? { head: m[1] ?? line, tail: m[2] ?? "" } : { head: line, tail: "" };
});
const [avif, fallback] = await Promise.all([
  getImage({ src: firstLight, format: "avif", widths, quality: 60 }),
  getImage({ src: firstLight, format: "webp", width: 1672, quality: 74 }),
]);
---

<section class="install" id="install" aria-labelledby="install-title">
  <div class="band">
    <picture>
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes="100vw" />
      <img
        src={fallback.src}
        width={firstLight.width}
        height={firstLight.height}
        alt="The same ship at first light, in calm water."
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>

  <div class="install__body wrap split">
    <h2 id="install-title">Get safina</h2>
    <div class="install__main">
      {
        release.available ? (
          <div class="downloads" data-downloads>
            <p class="lede">One binary. Download it, put it on your PATH,&nbsp;run&nbsp;<code>safina</code>.</p>
            <p class="release-tag">
              {release.version && <span>v{release.version}</span>}
              <span>MIT</span>
              <span>macOS · Linux</span>
              <a href={`${release.repo}/releases/latest`}>release notes</a>
            </p>
            <ul class="downloads__list" role="list">
              {release.assets.map((a) => (
                <li>
                  <a class="btn btn--quiet" href={downloadUrl(a.file)} data-os={a.os} data-arch={a.arch}>
                    {a.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <>
            <p class="lede">Binaries for macOS and Linux come with the first release, <i>in&nbsp;sha&nbsp;Allah</i>. Until then, build&nbsp;from&nbsp;source:</p>
            <div class="command">
              <pre class="command__code" id="cmd" data-text={release.fromSource}><code>{steps.map(({ head, tail }) => <span class="command__line">{head}{tail && <><wbr />{tail}</>}</span>)}</code></pre>
              <button class="command__copy" type="button" data-copy="cmd">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.75" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M10.5 3.2v-.45A1.75 1.75 0 0 0 8.75 1H3.25A1.75 1.75 0 0 0 1.5 2.75v5.5A1.75 1.75 0 0 0 3.25 10h.45" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
                <span data-copy-label>Copy</span>
              </button>
            </div>
            <p class="quiet">You’ll need Go 1.27 or newer, and access to the repo while it’s private.</p>
          </>
        )
      }
    </div>
    <ul class="facts" role="list">
      <li><strong>Runs on your machine.</strong> It reads the kubeconfig you already have, auth plugins included, and never writes&nbsp;to&nbsp;it.</li>
      <li><strong>Nothing to install in the cluster.</strong> No in-cluster agent, operator or CRDs. Safina can only do what your RBAC lets&nbsp;you&nbsp;do.</li>
      <li><strong>Chat is optional.</strong> It runs through the <code>claude</code> CLI you already have, so there’s no API key to&nbsp;set&nbsp;up.</li>
    </ul>
  </div>
  <p class="visually-hidden" aria-live="polite" data-copy-status></p>
</section>

<script src="../scripts/install.ts"></script>

<style>
  /* The same ship in calm water: the stage the install block rises from. */
  .band {
    position: relative;
    aspect-ratio: 3;
    min-height: 320px;
    max-height: 60svh;
    width: 100%;
    overflow: hidden;
  }
  /* The photograph's subject is low in its frame: the ship, its amber mast
     lamp and the dawn line sit in the bottom third. The crop holds them
     (bottom-anchored; on phones shifted right so the bridge and lamp stay
     in), and the fades stay light enough that the ship reads as the same
     one the page opened on. */
  .band img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 100%;

    @media (width <= 640px) {
      object-position: 84% 100%;
    }
  }
  .band::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--abyss) 0%, rgb(from var(--abyss) r g b / 0%) 30%),
      linear-gradient(0deg, var(--abyss) 0%, rgb(from var(--abyss) r g b / 55%) 16%, rgb(from var(--abyss) r g b / 0%) 38%);
  }

  /* The band's own fade carries the rest of the section break. */
  .install {
    margin-top: var(--s4);
  }
  /* The same anatomy as every feature: the title on the title line, its
     content on the text line, their capitals level. It rises out of the
     photograph's sea, just under the ship's waterline, never over the ship.
     Side by side, the facts sit under the title, like the footer's name and
     licence below them, so the closing weighs the same on both sides. */
  .install__body {
    position: relative;
    z-index: 1;
    row-gap: var(--s2);
    margin-top: calc(-1 * clamp(48px, 5vw, 96px));
    padding-bottom: var(--s5);

    @media (width > 1100px) {
      grid-template-rows: auto 1fr;

      & > .install__main {
        grid-column: 2;
        grid-row: 1 / span 2;
      }
      & > .facts {
        grid-column: 1;
        grid-row: 2;
      }
    }
  }
  /* Stacked, the steps keep the measure they have on the text line. */
  .install__main {
    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }
  .lede {
    font-size: var(--t-lead);
  }
  .quiet {
    margin-top: var(--s1);
    font-size: var(--t-small);
    color: var(--fog);
    text-wrap: balance;
  }

  .command {
    position: relative;
    margin-top: var(--s2);
    border-radius: var(--radius-frame);
    background: var(--tn-bg);
    box-shadow:
      0 0 0 1px rgb(from var(--tn-fg) r g b / 11%),
      0 1px 0 0 var(--tn-edge) inset,
      0 30px 80px -40px rgb(from var(--tn-blue) r g b / 25%);
  }
  .command__code {
    margin: 0;
    padding: 18px 120px 18px 22px;
    overflow-x: auto;
    /* A line too long for its column wraps after a slash, hanging under
       the prompt, rather than scrolling. */
    white-space: pre-wrap;
    font-family: var(--mono);
    font-size: var(--t-ui);
    line-height: 1.8;
    color: var(--tn-fg);
    scrollbar-width: thin;
    scrollbar-color: rgb(from var(--tn-fg) r g b / 25%) transparent;
  }
  .command__code code {
    font-size: inherit;
  }
  .command__line {
    display: block;
    padding-left: 2.2ch;
    text-indent: -2.2ch;
  }
  .command__line::before {
    content: "$";
    margin-right: 1.2ch;
    /* The app's dim, lifted just enough to clear 3:1 on the terminal ground. */
    color: oklch(from var(--tn-dim) calc(l + 0.06) c h);
    user-select: none;
  }
  .command__copy {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 12px;
    border-radius: 9px;
    border: 1px solid var(--tn-edge);
    background: var(--tn-bg2);
    color: var(--tn-fg);
    font-size: var(--t-micro);
    font-weight: var(--w-ui);
    cursor: pointer;
    transition:
      border-color 160ms,
      color 160ms;
  }
  .command__copy:hover {
    border-color: rgb(from var(--tn-fg) r g b / 36%);
  }
  .command__copy[data-state="done"] {
    color: var(--tn-green);
    border-color: rgb(from var(--tn-green) r g b / 40%);
  }

  .downloads__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--s2);
    padding: 0;
  }

  /* s4 from what's above them: the grid's row gap (s2) plus s3. The title
     column's quiet second voice, a size under the reading text, so the
     command beside them leads. */
  .facts {
    display: grid;
    gap: var(--s2);
    margin-top: var(--s3);
    padding: 0;
    list-style: none;
    font-size: var(--t-ui);
    line-height: 1.55;
    color: var(--fog);

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }
  /* Run-in heads: the UI weight, in the title colour. */
  .facts strong {
    display: block;
    font-weight: var(--w-ui);
    color: var(--foam);
  }

  @media (width <= 640px) {
    .band {
      aspect-ratio: 4 / 3;
    }
    /* Long lines wrap after a slash, hanging under the prompt. */
    .command__code {
      padding: 16px 16px 64px;
      font-size: var(--t-micro);
    }
    .command__copy {
      top: auto;
      bottom: 12px;
      left: 12px;
      right: auto;
    }
  }
  /* What the download is, in the terminal's face, the way a release page
     labels one: version, license, platforms, and the notes to check. */
  .release-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.4ch;
    margin-top: var(--s1);
    font-family: var(--mono);
    font-size: var(--t-small);
    color: var(--fog);
  }
  .release-tag a {
    color: var(--spray);
  }
</style>
