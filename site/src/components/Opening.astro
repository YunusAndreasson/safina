---
import { getImage } from "astro:assets";
import storm from "../assets/img/storm-landscape.jpg";
import stormPortrait from "../assets/img/storm-portrait.jpg";
import { release } from "../data/release";
import Command from "./Command.astro";

// Art direction: a recomposed portrait frame for phones, the wide IMAX frame
// everywhere else. AVIF for every current browser, WebP for the bare <img>.
const wide = [960, 1280, 1672];
const tall = [480, 640, 760, 941];
const [landAvif, portAvif, fallback] = await Promise.all([
  getImage({ src: storm, format: "avif", widths: wide, quality: 54 }),
  getImage({ src: stormPortrait, format: "avif", widths: tall, quality: 50 }),
  getImage({ src: storm, format: "webp", width: 1672, quality: 76 }),
]);
const portraitMedia = "(aspect-ratio <= 4/5)";
---

<section class="opening" aria-labelledby="title">
  <div class="stage">
    <picture class="stage__photo">
      <source media={portraitMedia} type="image/avif" srcset={portAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={landAvif.srcSet.attribute} sizes="100vw" />
      <img
        src={fallback.src}
        width={storm.width}
        height={storm.height}
        alt="A container ship at night, bow lifting through a breaking wave in a violent storm, one amber lamp lit on its mast."
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
    <div class="stage__shade" aria-hidden="true"></div>
    <div class="stage__dim" aria-hidden="true"></div>
    <div class="stage__bar stage__bar--top" aria-hidden="true"></div>
    <div class="stage__bar stage__bar--bottom" aria-hidden="true"></div>

    <div class="stage__copy wrap">
      <h1 id="title" class="headline">
        <span class="visually-hidden">Safina: </span>The Kubernetes TUI<br class="headline__break" /> for teams that ship&nbsp;fast.
      </h1>
      <p class="lede">
        Safina answers a keypress in <a href="#compare">about 20&nbsp;ms</a> and shows 500 pods within a second
        of launch. It’s one Go binary on lazy <code>client-&#8288;go</code> informers, so it reads the cluster from
        watch caches instead of polling the&nbsp;API.
      </p>
      {
        release.available && (
          <div class="get">
            <Command id="cmd-hero" text={release.install} />
            <p class="get__note">
              Linux and macOS, on x86-64 or&nbsp;ARM64.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* The opening holds the frame still (sticky) for 75svh of scrolling. Over
     that distance the black bars close the IMAX-tall frame down to 2.39:1
     while the product window rises over it. Native scroll speed throughout. */
  .opening {
    position: relative;
    height: 175svh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--abyss);
    isolation: isolate;
  }

  .stage__photo,
  .stage__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The storm is framed for the space above the window (--frame), so the
     window always starts just under the bow, however tall the screen. */
  .stage__photo {
    height: var(--frame);
  }
  /* A backdrop, not the subject: muted so the product is the brightest thing
     on the first screen. */
  .stage__photo img {
    object-fit: cover;
    object-position: 64% 42%;
    transform-origin: 64% 42%;
    filter: brightness(0.62) saturate(0.75);
  }

  /* Contrast for the copy, and a black floor under the product window: the
     photo dissolves before the window starts, so the product never sits on
     the storm. */
  .stage__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(from var(--abyss) r g b / 82%) 0%, rgb(from var(--abyss) r g b / 55%) 34%, rgb(from var(--abyss) r g b / 0%) 62%),
      linear-gradient(0deg, var(--abyss) 0, var(--abyss) calc(var(--peek) - 8px), rgb(from var(--abyss) r g b / 0%) calc(var(--peek) + 0.26 * var(--frame))),
      linear-gradient(180deg, rgb(from var(--abyss) r g b / 55%) 0%, rgb(from var(--abyss) r g b / 0%) 18%);
  }
  /* The storm recedes as the window takes the frame. */
  .stage__dim {
    position: absolute;
    inset: 0;
    background: var(--abyss);
    opacity: 0;
  }
  /* Film grain, static: a texture, not an effect. */
  .stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/grain.webp") repeat;
    background-size: 160px;
    mix-blend-mode: overlay;
    opacity: 0.22;
    pointer-events: none;
  }

  .stage__bar {
    --bar: max(0px, (100svh - 100vw / 2.39) / 2);
    position: absolute;
    left: 0;
    right: 0;
    height: var(--bar);
    background: var(--abyss);
    scale: 1 0;
    z-index: 2;
  }
  .stage__bar--top {
    top: 0;
    transform-origin: top;
  }
  .stage__bar--bottom {
    bottom: 0;
    transform-origin: bottom;
  }

  .stage__copy {
    position: absolute;
    inset-inline: 0;
    bottom: calc(var(--peek) + clamp(24px, 6svh, 72px));
    z-index: 1;
  }
  /* Beside the ship, the copy and its buttons sit as one block in the middle
     of the sky between the bar and the window. The window can't rise past
     the bow, so on a big screen a block anchored to the window would leave
     the sky above it empty. Never closer to the window than the usual gap.
     Portrait frames keep the anchor: their ship sits above the copy. */
  @media (width > 640px) and (aspect-ratio > 4/5) and (height > 520px) {
    .stage__copy {
      top: var(--nav-h);
      bottom: var(--peek);
      display: flex;
      flex-direction: column;

      &::before,
      &::after {
        content: "";
        flex: 1 0 0;
      }
      &::after {
        min-height: clamp(24px, 6svh, 72px);
      }
    }
  }

  /* What it is, ending on the tagline, then the sentence under it and the
     line that installs it, at the lede's measure. Get safina stays in the
     bar. Phones, portrait frames and very short windows leave the line to
     the bar's button, so the ship above the copy stays clear. */
  .get {
    margin-top: clamp(20px, 3.4svh, 36px);
    max-width: 49ch;
    font-size: var(--t-pitch);

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
    @media (width <= 640px), (aspect-ratio <= 4/5), (height <= 520px) {
      display: none;
    }
  }
  .get__note {
    margin-top: 10px;
    font-size: var(--t-micro);
    color: var(--fog);
  }
  /* The hero's first stroke is the T's bar, and right below it is the
     button's hard edge. Against a filled edge a hung bar reads as an
     overshoot, so here the ink sits flush: 0.021em is the T's own side
     bearing. (Other titles hang 0.05em; see global.css.) */
  .headline {
    margin-inline-start: -0.021em;
  }
  /* The subtitle: a step under the headline in size, set apart from it by
     a little air, and about the headline's width at a comfortable measure
     (some 60 characters, three lines), so the two read as one block whose
     longest line stops short of the ship's bow at every width. */
  .lede {
    margin-top: clamp(16px, 3svh, 32px);
    max-width: 49ch;
    font-size: var(--t-pitch);
    line-height: 1.5;
    color: var(--spray);
    /* Even lines, never a stub of two words under three long ones. */
    text-wrap: balance;

    @media (width <= 1100px) {
      max-width: var(--measure);
    }
  }

  /* The portrait frame puts the ship and its lamp in its top quarter, above
     the copy, with dark sea below for the copy and the window to sit on.
     Anchored to the top and pushed right, so the whole ship stays in, and
     the push-in centres on the lamp. (Matches the <source> media.) */
  @media (aspect-ratio <= 4/5) {
    .stage__photo img {
      object-position: 72% 0%;
      transform-origin: 84% 14%;
    }
  }
  @media (width <= 640px) {
    .stage__shade {
      background:
        linear-gradient(
          0deg,
          var(--abyss) 0,
          var(--abyss) calc(var(--peek) - 8px),
          rgb(from var(--abyss) r g b / 72%) calc(var(--peek) + 18svh),
          rgb(from var(--abyss) r g b / 0%) calc(var(--peek) + 42svh)
        ),
        linear-gradient(180deg, rgb(from var(--abyss) r g b / 50%) 0%, rgb(from var(--abyss) r g b / 0%) 9%);
    }
    /* A touch sturdier at phone size, where 260 nears a hairline on 1x screens. */
    .headline {
      font-weight: 300;
    }
  }

  /* Landscape phones and very short windows: keep the name, the line and a
     glimpse of the product; the sentence waits for the deep dive. */
  @media (height <= 700px) and (width > 640px) {
    .lede {
      max-width: var(--measure);
      font-size: var(--t-body);
    }
  }
  @media (height <= 520px) {
    .stage__copy {
      bottom: calc(var(--peek) + 12px);
    }
    .headline {
      font-size: clamp(2.25rem, 14svh, 3.75rem);
    }
    .lede {
      display: none;
    }
  }

  /* The one orchestrated moment. Off for reduced motion and for engines
     without scroll-driven animations: both get the still frame. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The opening is the top of the document, so root scroll offsets map
         straight onto its 75svh hold. (A view timeline would be shifted by
         scroll-padding-top and start part-way closed.) */
      .stage__bar {
        animation: bar-close linear both;
        animation-timeline: scroll(root);
        animation-range: 0svh 46svh;
      }
      .stage__photo img {
        animation: push-in linear both;
        animation-timeline: scroll(root);
        animation-range: 0svh 75svh;
      }
      .stage__dim {
        animation: dim linear both;
        animation-timeline: scroll(root);
        animation-range: 25svh 75svh;
      }
      .stage__copy {
        animation: copy-out linear both;
        animation-timeline: scroll(root);
        animation-range: 2svh 22svh;
      }
    }
  }

  @keyframes bar-close {
    to {
      scale: 1;
    }
  }
  @keyframes push-in {
    from {
      scale: 1.06;
    }
    to {
      scale: 1;
    }
  }
  @keyframes dim {
    to {
      opacity: 0.55;
    }
  }
  @keyframes copy-out {
    to {
      opacity: 0;
      translate: 0 -6svh;
    }
  }
</style>
