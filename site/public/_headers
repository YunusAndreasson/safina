# Cloudflare's asset server reads this file (wrangler.jsonc) and never serves
# it. scripts/ship.mjs checks every rule below on the deployed site.

# Content-hashed by the build, so a file at a name never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Recordings are asciicast v2, lines of JSON. As text the edge compresses
# them (about 500 KB to 38 KB); as the default octet-stream it wouldn't.
/_astro/*.cast
  Content-Type: text/plain; charset=utf-8

# The install script, so a browser shows it as the text it is instead of
# downloading it. Anyone can read what `| sh` would run.
/install.sh
  Content-Type: text/plain; charset=utf-8
